+
+class TicketAgentEventSource {
+    private listeners = new Map<string, Set<EventListener>>();
+    private nativeSource: EventSource | null = null;
+    private closed = false;
+    private connecting = false;
+    private failures = 0;
+    private offlineReported = false;
+    private retryTimer: ReturnType<typeof setTimeout> | null = null;
+    onerror: ((event: Event) => void) | null = null;
+
+    private static readonly OFFLINE_FAILURE_THRESHOLD = 3;
+
+    constructor(private endpoint: string, private token: string, private clientId: string) {
+        void this.connect();
+    }
+
+    addEventListener(type: string, listener: EventListener) {
+        const listeners = this.listeners.get(type) || new Set<EventListener>();
+        listeners.add(listener);
+        this.listeners.set(type, listeners);
+        this.nativeSource?.addEventListener(type, listener);
+    }
+
+    close() {
+        this.closed = true;
+        if (this.retryTimer) clearTimeout(this.retryTimer);
+        this.retryTimer = null;
+        this.nativeSource?.close();
+        this.nativeSource = null;
+    }
+
+    reconnect() {
+        if (this.closed) return;
+        if (this.retryTimer) clearTimeout(this.retryTimer);
+        this.retryTimer = null;
+        this.nativeSource?.close();
+        this.nativeSource = null;
+        this.failures = 0;
+        this.offlineReported = false;
+        void this.connect();
+    }
+
+    private async connect() {
+        if (this.closed || this.connecting) return;
+        this.connecting = true;
+        try {
+            const response = await fetch(`${this.endpoint}/events-ticket`, {
+                method: "POST",
+                headers: { "content-type": "application/json", "x-canvas-agent-token": this.token },
+                body: JSON.stringify({ clientId: this.clientId }),
+            });
+            const data = await response.json().catch(() => ({})) as { ticket?: string };
+            if (!response.ok || !data.ticket) throw new Error("Agent event ticket request failed");
+            if (this.closed) return;
+            const source = new EventSource(`${this.endpoint}/events?ticket=${encodeURIComponent(data.ticket)}&clientId=${encodeURIComponent(this.clientId)}`);
+            this.nativeSource = source;
+            for (const [type, listeners] of this.listeners) for (const listener of listeners) source.addEventListener(type, listener);
+            source.onopen = () => {
+                this.failures = 0;
+                this.offlineReported = false;
+            };
+            source.onerror = (event) => {
+                if (this.nativeSource !== source) return;
+                source.close();
+                this.nativeSource = null;
+                this.reportFailure(event);
+                this.scheduleConnect();
+            };
+        } catch {
+            if (!this.closed) {
+                this.reportFailure(new Event("error"));
+                this.scheduleConnect();
+            }
+        } finally {
+            this.connecting = false;
+        }
+    }
+
+    private scheduleConnect() {
+        if (this.closed || this.retryTimer) return;
+        this.retryTimer = setTimeout(() => {
+            this.retryTimer = null;
+            void this.connect();
+        }, 3000);
+    }
+
+    private reportFailure(event: Event) {
+        this.failures += 1;
+        if (this.failures >= TicketAgentEventSource.OFFLINE_FAILURE_THRESHOLD && !this.offlineReported) {
+            this.offlineReported = true;
+            this.onerror?.(event);
+        }
+    }
+}
diff --git a/web/src/hooks/use-agent-asset-url.ts b/web/src/hooks/use-agent-asset-url.ts
new file mode 100644
index 0000000..a6a5dee
--- /dev/null
+++ b/web/src/hooks/use-agent-asset-url.ts
@@ -0,0 +1,29 @@
+import { useEffect, useState } from "react";
+
+import { loadAgentAssetObjectUrl } from "@/services/api/canvas-agent";
+import { useAgentStore } from "@/stores/use-agent-store";
+
+export function useAgentAssetUrl(value: string) {
+    const endpoint = useAgentStore((state) => state.url);
+    const token = useAgentStore((state) => state.token);
+    const [source, setSource] = useState("");
+
+    useEffect(() => {
+        const controller = new AbortController();
+        let objectUrl = "";
+        void loadAgentAssetObjectUrl(endpoint, token, value, controller.signal).then((url) => {
+            if (controller.signal.aborted) {
+                if (url.startsWith("blob:")) URL.revokeObjectURL(url);
+                return;
+            }
+            objectUrl = url.startsWith("blob:") ? url : "";
+            setSource(url);
+        });
+        return () => {
+            controller.abort();
+            if (objectUrl) URL.revokeObjectURL(objectUrl);
+        };
+    }, [endpoint, token, value]);
+
+    return source;
+}
