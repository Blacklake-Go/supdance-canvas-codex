+    if (!baseUrl || !token) return "";
+    try {
+        const target = new URL(value, baseUrl);
+        const base = new URL(baseUrl);
+        if (target.origin !== base.origin || !/^\/agent\/(?:message-assets|attachments)\//.test(target.pathname)) return value;
